{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_git_worktree_remove",
  "capability_level": "L2",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.project.write",
    "mac.git.write"
  ],
  "normalized_target_type": "project_root",
