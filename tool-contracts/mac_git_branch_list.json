{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_git_branch_list",
  "capability_level": "L2",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.git.read"
  ],
  "normalized_target_type": "project_root",
  "timeout_ms": 10000,
  "output_cap_bytes": 262144,
  "network_policy": "none",
  "filesystem_policy": "read_allowed_project",
  "secret_policy": "redact",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "bounded_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "developer_read",
  "tool_delivery_wave": "wave_3",
  "implementation_status": "planned",
  "purpose": "return local/remote branch metadata without checkout, switch or fetch.",
  "input_summary": "project_root:string, include_remote?:boolean.",
  "output_summary": "branches, current branch, upstream/ahead/behind if locally known.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_git_branch_list input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "project_root": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "include_remote": {
        "type": "boolean"
      }
    },
    "required": [
      "project_root"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_git_branch_list result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_git_branch_list"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "branches": {
            "type": "array",
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "current": {
                  "type": "boolean"
                },
                "upstream": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 256
                },
                "ahead": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "behind": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "name",
                "current"
              ]
            }
          }
        },
        "required": [
          "project_root",
          "branches"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "bounded_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "889f7cd2-a545-4ed5-9686-cf225650e349",
    "source_text": "Purpose: return local/remote branch metadata without checkout, switch or fetch. Input: project_root:string, include_remote?:boolean. Output: branches, current branch, upstream/ahead/behind if locally known. Contract: L2 read_only; scope mac.git.read; target project_root; timeout 10000ms; cap 256KiB; network none; filesystem read_allowed_project; secrets redacted; approval trusted_read; idempotent yes. Phase 3 planned."
  }
}
