{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_ui_type",
  "capability_level": "L4",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.ui.control"
  ],
  "normalized_target_type": "ui_element",
  "timeout_ms": 15000,
  "output_cap_bytes": 262144,
  "network_policy": "none",
  "filesystem_policy": "none",
  "secret_policy": "never_type_into_secret_fields",
  "approval_policy": "trusted_gui",
  "idempotent": false,
  "postcondition_verification": {
    "required": true,
    "strategy": "focused_target_and_input_postcondition",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "gui_control",
  "tool_delivery_wave": "wave_4",
    "implementation_status": "planned",
  "purpose": "send bounded text/keys only to an approved focused UI target.",
  "input_summary": "element_ref:string, text:string<=10000, keys?:bounded enum[], submit?:boolean.",
  "output_summary": "characters accepted and postcondition state, never echoed from secure fields.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_ui_type input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "element_ref": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:/-]+$"
      },
      "text": {
        "type": "string",
        "minLength": 0,
        "maxLength": 10000
      },
      "keys": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "enum": [
            "ENTER",
            "TAB",
            "ESCAPE",
            "ARROW_UP",
            "ARROW_DOWN",
            "ARROW_LEFT",
            "ARROW_RIGHT",
            "HOME",
            "END"
          ]
        }
      },
      "submit": {
        "type": "boolean"
      }
    },
    "required": [
      "element_ref",
      "text"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_ui_type result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_ui_type"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "element_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "characters_accepted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "keys_accepted": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": false,
            "items": {
              "enum": [
                "ENTER",
                "TAB",
                "ESCAPE",
                "ARROW_UP",
                "ARROW_DOWN",
                "ARROW_LEFT",
                "ARROW_RIGHT",
                "HOME",
                "END"
              ]
            }
          },
          "submitted": {
            "type": "boolean"
          },
          "focus_confirmed": {
            "type": "boolean"
          },
          "reobserved": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "focused": {
                "type": "boolean"
              },
              "secure": {
                "type": "boolean"
              },
              "state": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              }
            },
            "required": [
              "role",
              "focused",
              "secure"
            ]
          }
        },
        "required": [
          "element_ref",
          "characters_accepted",
          "keys_accepted",
          "submitted",
          "focus_confirmed",
          "reobserved"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "const": "focused_target_and_input_postcondition"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "02467fdc-eed1-40a2-a90f-372064c60386",
    "source_text": "Purpose: send bounded text/keys only to an approved focused UI target. Input: element_ref:string, text:string<=10000, submit?:boolean. Output: characters accepted and postcondition state, never echoed from secure fields. Contract: L4 writes_local; scope mac.ui.control; target ui_element; timeout 15000ms; cap 256KiB; no network/filesystem; MUST refuse password, credential, security/privacy and secure text fields; approval trusted_gui; non-idempotent. Phase 4 planned."
  }
}
