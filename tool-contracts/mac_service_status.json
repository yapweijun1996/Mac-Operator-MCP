{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_service_status",
  "capability_level": "L0",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.service.read"
  ],
  "normalized_target_type": "service_id",
  "timeout_ms": 5000,
  "output_cap_bytes": 131072,
  "network_policy": "none",
  "filesystem_policy": "none",
  "secret_policy": "redact",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "service_state_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "observe",
  "tool_delivery_wave": "wave_2",
  "implementation_status": "planned",
  "purpose": "inspect an allowlisted launchd/service identifier without mutation.",
  "input_summary": "service_id:string.",
  "output_summary": "loaded/running/state/last-exit safe facts.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_service_status input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "service_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:@/+-]+$"
      }
    },
    "required": [
      "service_id"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_service_status result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_service_status"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "service_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:@/+-]+$"
              },
              "loaded": {
                "type": "boolean"
              },
              "running": {
                "type": "boolean"
              },
              "state": {
                "enum": [
                  "loaded",
                  "running",
                  "stopped",
                  "failed",
                  "unknown"
                ]
              },
              "last_exit_code": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -2147483648,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pid": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99999999
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "service_id",
              "loaded",
              "running",
              "state",
              "last_exit_code"
            ]
          }
        },
        "required": [
          "service"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "service_state_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "e5c0ade7-19a4-47ac-a967-182371fb1c9f",
    "source_text": "Purpose: inspect an allowlisted launchd/service identifier without mutation. Input: service_id:string. Output: loaded/running/state/last-exit safe facts. Contract: L0 read_only; scope mac.service.read; target service_id; timeout 5000ms; cap 128KiB; no network/filesystem; secrets redacted; approval trusted_read; idempotent yes. Phase 2 planned."
  }
}
