{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_app_open",
  "capability_level": "L3",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.app.control"
  ],
  "normalized_target_type": "app_id",
  "timeout_ms": 30000,
  "output_cap_bytes": 262144,
  "network_policy": "explicit_allowlist_only",
  "filesystem_policy": "path_if_explicit_allowlist",
  "secret_policy": "deny_sensitive_targets",
  "approval_policy": "trusted_gui",
  "idempotent": false,
  "postcondition_verification": {
    "required": true,
    "strategy": "launch_state_and_target_reobservation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "app_control",
  "tool_delivery_wave": "wave_4",
  "implementation_status": "planned",
  "purpose": "Launch an allowlisted app by bundle ID, such as com.google.Chrome. Navigate URLs afterward with mac_ui_action and mac_ui_type; direct URL and document opening are unavailable.",
  "input_summary": "app_id:bundle ID (for Chrome, com.google.Chrome).",
  "output_summary": "launched/already-running state and verified target.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_app_open input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "app_id": {
        "type": "string",
        "description": "Use com.google.Chrome for Chrome or com.apple.Safari for Safari. A bundle: prefix is also accepted.",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(bundle:)?[A-Za-z0-9][A-Za-z0-9._:@+\\-]{0,255}$"
      }
    },
    "required": [
      "app_id"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_app_open result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_app_open"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^bundle:[A-Za-z0-9][A-Za-z0-9._:@+\\-]{0,255}$"
          },
          "state": {
            "enum": [
              "launched",
              "already_running",
              "denied",
              "failed"
            ]
          },
          "process_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 99999999
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "app",
                  "document",
                  "url"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 0,
                "maxLength": 4096
              }
            },
            "required": [
              "kind",
              "reference"
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "job_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^job:app-open-[a-f0-9]{48}$"
          }
        },
        "required": [
          "app_id",
          "state",
          "process_id",
          "target",
          "verified",
          "job_id"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "const": "launch_state_and_target_reobservation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "c200dad7-21c9-4e2f-a22d-6714b830ec2c",
    "source_text": "Purpose: launch an allowlisted app and optional approved document/URL; no arbitrary script execution. Input: app_id:string, document_path?:string, url?:string. Output: launched/already-running state and verified target. Contract: L3 writes_local; scope mac.app.control; target app_id; timeout 30000ms; cap 256KiB; network only for explicitly allowed URL schemes/hosts; filesystem path allowlist; sensitive targets denied; approval trusted_app_control. Phase 4 planned."
  }
}
