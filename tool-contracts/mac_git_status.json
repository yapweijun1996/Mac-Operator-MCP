            "maxLength": 128,
            "pattern": "^[A-Fa-f0-9]{64,128}$"
          },
          "staged_paths": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "unstaged_paths": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "untracked_paths": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "conflicted_paths": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "dirty": {
            "type": "boolean"
          }
        },
        "required": [
          "project_root",
          "branch",
          "head",
          "staged_paths",
          "unstaged_paths",
          "untracked_paths",
          "conflicted_paths",
          "dirty"
