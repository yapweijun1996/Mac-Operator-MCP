{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_apply_patch",
  "capability_level": "L2",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.files.write",
    "mac.project.write"
  ],
  "normalized_target_type": "project_root",
  "timeout_ms": 30000,
  "output_cap_bytes": 524288,
  "network_policy": "none",
  "filesystem_policy": "write_allowed_project",
  "secret_policy": "deny_secret_content",
  "approval_policy": "trusted_write",
  "idempotent": false,
  "postcondition_verification": {
    "required": true,
    "strategy": "changed_paths_and_hash_readback",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "filesystem_write",
  "tool_delivery_wave": "wave_3",
  "implementation_status": "planned",
  "purpose": "apply bounded textual patch under an authorized project root. Not available inside Broker-managed worktrees; those are changed only by mac_codex_run.",
  "input_summary": "project_root:string, patch:string, expected_base_hash?:string.",
  "output_summary": "changed paths, precondition result, post-write hashes and verification.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_apply_patch input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "project_root": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "patch": {
        "type": "string",
        "minLength": 1,
        "maxLength": 524288
      },
      "expected_base_hash": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    },
    "required": [
      "project_root",
      "patch"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_apply_patch result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_apply_patch"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "project_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "result": {
            "enum": [
              "applied",
              "no_change",
              "failed"
            ]
          },
          "changed_paths": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "precondition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "checked": {
                "type": "boolean"
              },
              "expected_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actual_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "matched": {
                "type": "boolean"
              }
            },
            "required": [
              "checked",
              "matched"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]+$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[A-Fa-f0-9]{64}$"
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000
                }
              },
              "required": [
                "path",
                "sha256",
                "size_bytes"
              ]
            }
          }
        },
        "required": [
          "job_id",
          "project_root",
          "result",
          "changed_paths",
          "precondition",
          "files"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "const": "changed_paths_and_hash_readback"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "f9267032-0618-4c2e-a3d6-760fcfcbd2f3",
    "source_text": "Purpose: apply bounded textual patch under an authorized project root. Input: project_root:string, patch:string, expected_base_hash?:string. Output: changed paths, precondition result, post-write hashes and verification. Contract: L2 writes_local; scopes mac.files.write + mac.project.write; target project_root; timeout 30000ms; cap 512KiB; network none; filesystem write_allowed_project; secret paths/content denied; approval trusted_write; non-idempotent unless expected hash makes retry safe. Phase 3 planned."
  }
}
