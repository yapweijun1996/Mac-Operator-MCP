{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_ui_observe",
  "capability_level": "L4",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.ui.observe"
  ],
  "normalized_target_type": "app_window",
  "timeout_ms": 10000,
  "output_cap_bytes": 786432,
  "network_policy": "none",
  "filesystem_policy": "none",
  "secret_policy": "deny_sensitive_targets_and_mask_secure_ui",
  "approval_policy": "trusted_gui",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "accessibility_snapshot_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "gui_control",
  "tool_delivery_wave": "wave_4",
  "implementation_status": "planned",
  "purpose": "Observe an authorized ordinary application window or, with explicit desktop delegation, one full display using app_id=desktop. Focus background applications with mac_app_focus; desktop observation does not change focus.",
  "input_summary": "app_id:bundle ID|desktop, window_hint?:exact window title|display:<id>, max_nodes?:1..2000, capture_mode?:none|screen|active_window|selected_window. For desktop screenshots prefer screen.",
  "output_summary": "Safe Accessibility metadata and optional JPEG MCP image with global capture geometry and a fresh visual_ref. Desktop uses canonical app_id bundle:dev.macoperator.desktop; none returns empty AX nodes without an image/ref.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_ui_observe input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "app_id": {
        "type": "string",
        "description": "An authorized application's bundle ID, such as com.apple.TextEdit or com.google.Chrome (optional bundle: prefix), or desktop for a full-display observation under explicit owner desktop delegation. Desktop cannot be opened or focused.",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(bundle:)?[A-Za-z0-9][A-Za-z0-9._:@+\\-]{0,255}$"
      },
      "window_hint": {
        "type": "string",
        "description": "An exact application window title, or display:<numeric macOS display ID> for desktop; desktop defaults to the main display when absent.",
        "minLength": 0,
        "maxLength": 256
      },
      "max_nodes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000
      },
      "capture_mode": {
        "description": "Application capture mode; active_window is the default. Desktop screenshot modes normalize to screen, with selected_window still requiring window_hint. Desktop none returns no screenshot or actionable visual_ref.",
        "enum": [
          "none",
          "screen",
          "active_window",
          "selected_window"
        ]
      }
    },
    "required": [
      "app_id"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_ui_observe result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_ui_observe"
      },
      "result_class": {
        "const": "SUCCEEDED"
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "window_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "window_title": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512
          },
          "focused": {
            "type": "boolean"
          },
          "nodes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2000,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "element_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:/-]+$"
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "label": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 512
                },
                "enabled": {
                  "type": "boolean"
                },
                "focused": {
                  "type": "boolean"
                },
                "secure": {
                  "type": "boolean"
                }
              },
              "required": [
                "element_ref",
                "role",
                "enabled",
                "focused",
                "secure"
              ]
            }
          },
          "truncated": {
            "type": "boolean"
          },
          "screenshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "mime_type",
              "screen_width",
              "screen_height",
              "window_x",
              "window_y",
              "window_width",
              "window_height",
              "capture_width",
              "capture_height",
              "image_width",
              "image_height"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "screen",
                  "active_window",
                  "selected_window"
                ]
              },
              "mime_type": {
                "const": "image/jpeg"
              },
              "image_base64": {
                "type": "string",
                "minLength": 100,
                "maxLength": 640000,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "screen_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "screen_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "window_x": {
                "type": "integer",
                "minimum": -20000,
                "maximum": 20000
              },
              "window_y": {
                "type": "integer",
                "minimum": -20000,
                "maximum": 20000
              },
              "window_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "window_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "capture_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "capture_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "image_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "image_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              }
            }
          },
          "visual_ref": {
            "type": "string",
            "description": "Fresh screenshot-backed target reference; pass as mac_ui_action.element_ref. Desktop screen refs constrain global actions to the observed display.",
            "pattern": "^element:[a-f0-9]{48}$"
          }
        },
        "required": [
          "app_id",
          "window_id",
          "focused",
          "nodes",
          "truncated"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "accessibility_snapshot_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "53141f65-7628-46e8-8475-14bbe4465b5c",
    "source_text": "Purpose: bounded Accessibility-tree snapshot for an approved app/window. Input: app_id:string, window_hint?:string, max_nodes?:1..2000. Output: stable opaque element refs, roles, labels and safe states; secure nodes masked. Contract: L4 read_only; scope mac.ui.observe; target app_window; timeout 10000ms; cap 512KiB; no network/filesystem; sensitive/security/credential targets denied and secure UI/password content masked; approval trusted_gui; idempotent yes. Phase 4 planned."
  }
}
