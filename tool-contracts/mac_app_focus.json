{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_app_focus",
  "capability_level": "L3",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.app.control"
  ],
  "normalized_target_type": "app_window",
  "timeout_ms": 10000,
  "output_cap_bytes": 131072,
  "network_policy": "none",
  "filesystem_policy": "none",
  "secret_policy": "deny_sensitive_targets",
  "approval_policy": "trusted_gui",
  "idempotent": false,
  "postcondition_verification": {
    "required": true,
    "strategy": "focused_app_window_reobservation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "app_control",
  "tool_delivery_wave": "wave_4",
  "implementation_status": "planned",
  "purpose": "Bring an authorized concrete ordinary application window to the foreground through MCP and verify its native identity before interaction, without manual owner foregrounding. The desktop observation alias cannot be focused.",
  "input_summary": "app_id:bundle ID (for example com.apple.TextEdit or com.google.Chrome), window_hint?:string.",
  "output_summary": "resolved app/window and focus verification.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_app_focus input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "app_id": {
        "type": "string",
        "description": "The authorized concrete application's bundle ID, for example com.apple.TextEdit or com.google.Chrome. A bundle: prefix is accepted; desktop is unsupported.",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(bundle:)?[A-Za-z0-9][A-Za-z0-9._:@+\\-]{0,255}$"
      },
      "window_hint": {
        "type": "string",
        "minLength": 0,
        "maxLength": 256
      }
    },
    "required": [
      "app_id"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_app_focus result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_app_focus"
      },
      "result_class": {
        "const": "SUCCEEDED"
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "app_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "window_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "verified": {
            "const": true
          },
          "job_id": {
            "type": "string",
            "pattern": "^job:app-focus-[a-f0-9]{48}$"
          },
          "window_title": {
            "type": "string",
            "minLength": 0,
            "maxLength": 512
          },
          "focused": {
            "type": "boolean"
          },
          "reobserved_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "format": "date-time"
          }
        },
        "required": [
          "app_id",
          "window_id",
          "focused",
          "reobserved_at",
          "verified",
          "job_id"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "const": "focused_app_window_reobservation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "11cdbfed-ec6c-4445-9946-1734631aa9bb",
    "source_text": "Purpose: focus an allowlisted running app/window by normalized identity. Input: app_id:string, window_hint?:string. Output: resolved app/window and focus verification. Contract: L3 writes_local; scope mac.app.control; target app_window; timeout 10000ms; cap 128KiB; no network/filesystem; sensitive/system-security targets denied; approval trusted_gui; Broker Job readback required; operation may be repeated safely after re-resolution. Phase 4 planned."
  }
}
