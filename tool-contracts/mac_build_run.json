{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_build_run",
  "capability_level": "L2",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.project.read",
    "mac.project.write",
    "mac.task.run"
  ],
  "normalized_target_type": "project_root",
  "timeout_ms": 600000,
  "output_cap_bytes": 65536,
  "network_policy": "none",
  "filesystem_policy": "isolated_worktree",
  "secret_policy": "deny_secret_paths_and_env",
  "approval_policy": "trusted_profile",
  "idempotent": true,
  "postcondition_verification": {
    "required": true,
    "strategy": "exit_status_and_declared_task_verification",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "execution",
  "tool_delivery_wave": "wave_3",
  "implementation_status": "planned",
  "purpose": "Submit one approved existing build profile as a bounded Broker-managed worktree job; never accept an arbitrary shell command.",
  "input_summary": "project_root, worktree, task_id, max_runtime, idempotency_key, profile",
  "output_summary": "job_id, state, task_id, worktree, profile",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_build_run input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "project_root": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "worktree": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "task_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "max_runtime": {
        "type": "integer",
        "minimum": 1,
        "maximum": 600000
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "profile": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:@/+-]+$"
      }
    },
    "required": [
      "project_root",
      "worktree",
      "task_id",
      "max_runtime",
      "idempotency_key"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_build_run result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_build_run"
      },
      "result_class": {
        "const": "SUCCEEDED"
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled",
              "unknown"
            ]
          },
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "worktree": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:@/+-]+$"
          }
        },
        "required": [
          "job_id",
          "state",
          "task_id",
          "worktree",
          "profile"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "const": "exit_status_and_declared_task_verification"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "3c261233-3615-4473-9fcb-535afce6a930",
    "source_text": "Local V2 design contract from docs/MAC_OPERATOR_V2_DESIGN.md, 2026-10-01. This contract identifier is reserved locally and does not assert an existing KB item. Submit one approved existing build profile as a bounded Broker-managed worktree job; never accept an arbitrary shell command."
  }
}
