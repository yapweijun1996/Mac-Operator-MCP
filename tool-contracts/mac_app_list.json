{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_app_list",
  "capability_level": "L3",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.app.read"
  ],
  "normalized_target_type": "app_set",
  "timeout_ms": 10000,
  "output_cap_bytes": 262144,
  "network_policy": "none",
  "filesystem_policy": "app_metadata_only",
  "secret_policy": "redact",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "app_inventory_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "app_control",
  "tool_delivery_wave": "wave_4",
  "implementation_status": "planned",
  "purpose": "return installed/running app inventory with bundle identifiers and safe state.",
  "input_summary": "running_only?:boolean, include_installed?:boolean.",
  "output_summary": "allowlist-relevant app metadata.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_app_list input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "running_only": {
        "type": "boolean"
      },
      "include_installed": {
        "type": "boolean"
      }
    },
    "required": []
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_app_list result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_app_list"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apps": {
            "type": "array",
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "app_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:/-]+$"
                },
                "bundle_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:@/+-]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "running": {
                  "type": "boolean"
                },
                "version": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 128
                }
              },
              "required": [
                "app_id",
                "bundle_id",
                "name",
                "running"
              ]
            }
          }
        },
        "required": [
          "apps"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "app_inventory_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "0ca1aeba-4b4d-4ae5-b23e-fae8cb946361",
    "source_text": "Purpose: return installed/running app inventory with bundle identifiers and safe state. Input: running_only?:boolean, include_installed?:boolean. Output: allowlist-relevant app metadata. Contract: L3 read_only; scope mac.app.read; target app_set; timeout 10000ms; cap 256KiB; network/filesystem none except approved app metadata discovery; secrets redacted; approval trusted_read; idempotent yes. Phase 4 planned."
  }
}
