{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_storage_analysis",
  "capability_level": "L0",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.storage.read"
  ],
  "normalized_target_type": "filesystem_roots",
  "timeout_ms": 30000,
  "output_cap_bytes": 524288,
  "network_policy": "none",
  "filesystem_policy": "read_allowed_roots",
  "secret_policy": "deny_secret_content",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "bounded_storage_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "observe",
  "tool_delivery_wave": "wave_2",
  "implementation_status": "planned",
  "purpose": "analyze authorized volumes/capacity and bounded top storage consumers. Without roots it analyzes the content-readable roots, not the whole disk; macOS Library/CloudStorage folders are skipped.",
  "input_summary": "roots?:string[], top_n?:1..100, max_depth?:0..8.",
  "output_summary": "capacity facts and ranked consumers; deny zones excluded.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_storage_analysis input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "roots": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]+$"
        }
      },
      "top_n": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "max_depth": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8
      }
    },
    "required": []
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_storage_analysis result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_storage_analysis"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "volumes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._:/-]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "mount_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]+$"
                },
                "total_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000000000
                },
                "available_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000000000
                },
                "used_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000000000
                }
              },
              "required": [
                "id",
                "name",
                "mount_path",
                "total_bytes",
                "available_bytes",
                "used_bytes"
              ]
            }
          },
          "consumers": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]+$"
                },
                "size_bytes": {
                  "description": "Apparent size in bytes: a sum of stat sizes (not allocated disk blocks), so it can differ from Finder or du for sparse files, APFS clones and compression. For a directory it is the sum over entries visited beneath it. Symlinks, protected zones, macOS Library/CloudStorage and other volumes are excluded. It is a lower bound when the result is truncated or a warning says traversal was cut short.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000000000
                },
                "type": {
                  "enum": [
                    "file",
                    "directory",
                    "other"
                  ]
                }
              },
              "required": [
                "path",
                "size_bytes",
                "type"
              ]
            }
          },
          "analyzed_roots": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          }
        },
        "required": [
          "volumes",
          "consumers",
          "analyzed_roots"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "bounded_storage_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "92d451d9-ec56-4af6-8fcd-9e08082285aa",
    "source_text": "Purpose: analyze authorized volumes/capacity and bounded top storage consumers. Input: roots?:string[], top_n?:1..100, max_depth?:0..8. Output: capacity facts and ranked consumers; deny zones excluded. Contract: L0 read_only; scope mac.storage.read; target filesystem_roots; timeout 30000ms; cap 512KiB; network none; filesystem read_allowed_roots; secret contents denied; approval trusted_read; idempotent yes. Phase 2 planned."
  }
}
