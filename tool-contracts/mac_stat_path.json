{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_stat_path",
  "capability_level": "L1",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.files.read"
  ],
  "normalized_target_type": "path",
  "timeout_ms": 5000,
  "output_cap_bytes": 131072,
  "network_policy": "none",
  "filesystem_policy": "metadata_allowed_roots",
  "secret_policy": "existence_only_for_secret_zones",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "canonical_metadata_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "filesystem_read",
  "tool_delivery_wave": "wave_2",
  "implementation_status": "planned",
  "purpose": "return safe metadata for one canonical path without opening protected secret contents.",
  "input_summary": "path:string, follow_symlink?:boolean.",
  "output_summary": "type,size,timestamps,mode,symlink metadata subject to policy.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_stat_path input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "follow_symlink": {
        "type": "boolean"
      }
    },
    "required": [
      "path"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_stat_path result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_stat_path"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "type": {
            "enum": [
              "file",
              "directory",
              "symlink",
              "other"
            ]
          },
          "size_bytes": {
            "description": "Size in bytes of this entry itself, as reported by stat. For type=file it is the file length. For type=directory it is only the size of the directory entry (for example 160 on APFS) and does NOT include the directory's contents; for an unfollowed symlink it is the length of the link target path. For the total space used by a directory use mac_storage_analysis.",
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "modified_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "symlink": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "is_symlink": {
                "type": "boolean"
              },
              "target_type": {
                "anyOf": [
                  {
                    "enum": [
                      "file",
                      "directory",
                      "other"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "is_symlink"
            ]
          }
        },
        "required": [
          "path",
          "type",
          "size_bytes",
          "modified_at",
          "mode",
          "symlink"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "canonical_metadata_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "f992c130-5dba-40e8-8f6b-f6bd6b621fcc",
    "source_text": "Purpose: return safe metadata for one canonical path without opening protected secret contents. Input: path:string, follow_symlink?:boolean. Output: type,size,timestamps,mode,symlink metadata subject to policy. Contract: L1 read_only; scope mac.files.read; target path; timeout 5000ms; cap 128KiB; network none; filesystem metadata_allowed_roots; secret zones existence-only; approval trusted_read; idempotent yes. Phase 2 planned."
  }
}
