{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_task_run",
  "capability_level": "L2",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.task.run"
  ],
  "normalized_target_type": "task_profile",
  "timeout_ms": 600000,
  "output_cap_bytes": 2097152,
  "network_policy": "profile_defined",
  "filesystem_policy": "profile_defined",
  "secret_policy": "deny_secret_env",
  "approval_policy": "trusted_profile",
  "idempotent": false,
  "postcondition_verification": {
    "required": true,
    "strategy": "exit_status_and_declared_task_verification",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "execution",
  "tool_delivery_wave": "wave_3",
  "implementation_status": "planned",
  "purpose": "execute one allowlisted named task profile such as test/build; no arbitrary command string.",
  "input_summary": "profile:string, cwd:string, args?:string[], async?:boolean.",
  "output_summary": "result or broker job_id, bounded stdout/stderr, exit class, verification.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_task_run input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "profile": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:@/+-]+$"
      },
      "cwd": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "args": {
        "type": "array",
        "minItems": 0,
        "maxItems": 64,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        }
      },
      "async": {
        "type": "boolean"
      }
    },
    "required": [
      "profile",
      "cwd"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_task_run result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_task_run"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:@/+-]+$"
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled",
              "unknown"
            ]
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._:/-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "stdout": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2097152
          },
          "stderr": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2097152
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "profile",
          "cwd",
          "state",
          "job_id",
          "exit_code",
          "stdout",
          "stderr",
          "truncated"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "const": "exit_status_and_declared_task_verification"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "d1c6a0c1-266c-488c-884b-86b3ae381986",
    "source_text": "Purpose: execute one allowlisted named task profile such as test/build; no arbitrary command string. Input: profile:string, cwd:string, args?:string[], async?:boolean. Output: result or broker job_id, bounded stdout/stderr, exit class, verification. Contract: L2 writes_local; scope mac.task.run; target task_profile; timeout max 600000ms; cap 2MiB; network/profile-defined; filesystem/profile-defined; minimal env and secret-env denial; approval trusted_profile; non-idempotent unless profile declares otherwise. Phase 3 planned."
  }
}
