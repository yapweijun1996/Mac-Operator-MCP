{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_directory_tree",
  "capability_level": "L1",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.files.read"
  ],
  "normalized_target_type": "path",
  "timeout_ms": 10000,
  "output_cap_bytes": 524288,
  "network_policy": "none",
  "filesystem_policy": "read_allowed_roots",
  "secret_policy": "deny_secret_content",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "bounded_tree_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "filesystem_read",
  "tool_delivery_wave": "wave_2",
  "implementation_status": "planned",
  "purpose": "return a depth/entry bounded directory tree for an authorized root.",
  "input_summary": "path:string, depth?:0..8, max_entries?:1..5000.",
  "output_summary": "sanitized tree with truncation.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_directory_tree input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "depth": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8
      },
      "max_entries": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000
      }
    },
    "required": [
      "path"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_directory_tree result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_directory_tree"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "entries": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]+$"
                },
                "type": {
                  "enum": [
                    "file",
                    "directory",
                    "symlink",
                    "other"
                  ]
                },
                "depth": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                },
                "size_bytes": {
                  "description": "Size in bytes of this entry itself, as reported by stat. For type=file it is the file length. For type=directory it is only the size of the directory entry (for example 160 on APFS) and does NOT include the directory's contents; for an unfollowed symlink it is the length of the link target path. For the total space used by a directory use mac_storage_analysis.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              },
              "required": [
                "path",
                "type",
                "depth"
              ]
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "root",
          "entries",
          "truncated"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "bounded_tree_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "6005b81b-b74e-40c3-9ed0-025298afb5fb",
    "source_text": "Purpose: return a depth/entry bounded directory tree for an authorized root. Input: path:string, depth?:0..8, max_entries?:1..5000. Output: sanitized tree with truncation. Contract: L1 read_only; scope mac.files.read; target path; timeout 10000ms; cap 512KiB; network none; filesystem read_allowed_roots; deny-zone filtering mandatory; approval trusted_read; idempotent yes. Phase 2 planned."
  }
}
