{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_git_stage",
  "capability_level": "L2",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.git.write"
  ],
  "normalized_target_type": "project_root",
  "timeout_ms": 15000,
  "output_cap_bytes": 262144,
  "network_policy": "none",
  "filesystem_policy": "write_allowed_project",
  "secret_policy": "deny_secret_paths",
  "approval_policy": "trusted_write",
  "idempotent": false,
  "postcondition_verification": {
    "required": true,
    "strategy": "staged_diff_hash",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "git_write",
  "tool_delivery_wave": "wave_3",
  "implementation_status": "planned",
  "purpose": "stage only explicit authorized paths in one repository; never implicit all-files staging.",
  "input_summary": "project_root:string, paths:string[] non-empty.",
  "output_summary": "staged paths, skipped/denied paths and staged diff hash.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_git_stage input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "project_root": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "paths": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5000,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "required": [
      "project_root",
      "paths"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_git_stage result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_git_stage"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "staged_paths": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "skipped_paths": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "staged_diff_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "index_changed": {
            "type": "boolean"
          }
        },
        "required": [
          "project_root",
          "staged_paths",
          "skipped_paths",
          "staged_diff_sha256",
          "index_changed"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "const": "staged_diff_hash"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "683caa43-3811-4756-acec-36389175c454",
    "source_text": "Purpose: stage only explicit authorized paths in one repository; never implicit all-files staging. Input: project_root:string, paths:string[] non-empty. Output: staged paths, skipped/denied paths and staged diff hash. Contract: L2 writes_local; scope mac.git.write; target project_root; timeout 15000ms; cap 256KiB; network none; filesystem write_allowed_project; secret paths denied; approval trusted_write; retry must verify current index state. Phase 3 planned."
  }
}
