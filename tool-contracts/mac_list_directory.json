{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_list_directory",
  "capability_level": "L1",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.files.read"
  ],
  "normalized_target_type": "path",
  "timeout_ms": 5000,
  "output_cap_bytes": 262144,
  "network_policy": "none",
  "filesystem_policy": "read_allowed_roots",
  "secret_policy": "deny_secret_content",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "bounded_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "filesystem_read",
  "tool_delivery_wave": "wave_2",
  "implementation_status": "planned",
  "purpose": "list entries for one canonical authorized directory with bounded pagination.",
  "input_summary": "path:string, cursor?:string, limit?:1..500, include_hidden?:boolean.",
  "output_summary": "names/types/safe metadata and next cursor.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_list_directory input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "cursor": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "include_hidden": {
        "type": "boolean"
      }
    },
    "required": [
      "path"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_list_directory result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_list_directory"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "entries": {
            "type": "array",
            "minItems": 0,
            "maxItems": 500,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "type": {
                  "enum": [
                    "file",
                    "directory",
                    "symlink",
                    "other"
                  ]
                },
                "size_bytes": {
                  "description": "Size in bytes of this entry itself, as reported by stat. For type=file it is the file length. For type=directory it is only the size of the directory entry (for example 160 on APFS) and does NOT include the directory's contents; for an unfollowed symlink it is the length of the link target path. For the total space used by a directory use mac_storage_analysis.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "modified_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "hidden": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "type"
              ]
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "entries",
          "next_cursor"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "bounded_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "98253c3d-aa71-4a7c-91aa-18b896a80c72",
    "source_text": "Purpose: list entries for one canonical authorized directory with bounded pagination. Input: path:string, cursor?:string, limit?:1..500, include_hidden?:boolean. Output: names/types/safe metadata and next cursor. Contract: L1 read_only; scope mac.files.read; target path; timeout 5000ms; cap 256KiB; network none; filesystem read_allowed_roots; deny secret content and filter protected entries; approval trusted_read; idempotent yes. Phase 2 planned."
  }
}
