{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_package_inspect",
  "capability_level": "L2",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.package.read"
  ],
  "normalized_target_type": "project_root",
  "timeout_ms": 30000,
  "output_cap_bytes": 524288,
  "network_policy": "allowlisted_registry_read_optional",
  "filesystem_policy": "read_allowed_project",
  "secret_policy": "deny_secret_content",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "package_metadata_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "developer_read",
  "tool_delivery_wave": "wave_3",
  "implementation_status": "planned",
  "purpose": "inspect supported package-manager manifests/locks and optional outdated metadata without install/update.",
  "input_summary": "project_root:string, manager?:auto|npm|pnpm|yarn|pip|uv|poetry|brew, check_outdated?:boolean.",
  "output_summary": "manager, dependencies/lock facts, safe outdated summary.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_package_inspect input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "project_root": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "manager": {
        "enum": [
          "auto",
          "npm",
          "pnpm",
          "yarn",
          "pip",
          "uv",
          "poetry",
          "brew"
        ]
      },
      "check_outdated": {
        "type": "boolean"
      }
    },
    "required": [
      "project_root"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_package_inspect result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_package_inspect"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "manager": {
            "enum": [
              "npm",
              "pnpm",
              "yarn",
              "pip",
              "uv",
              "poetry",
              "brew",
              "unknown"
            ]
          },
          "dependencies": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 128
                },
                "source": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 256
                }
              },
              "required": [
                "name",
                "version"
              ]
            }
          },
          "lockfile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "present": {
                "type": "boolean"
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^[^\\u0000]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "present"
            ]
          },
          "outdated": {
            "type": "array",
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "current": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 128
                },
                "latest": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 128
                }
              },
              "required": [
                "name",
                "current",
                "latest"
              ]
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "project_root",
          "manager",
          "dependencies",
          "lockfile",
          "outdated",
          "truncated"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "package_metadata_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "c22b2bed-5716-4855-9d73-7f3c069a8d0a",
    "source_text": "Purpose: inspect supported package-manager manifests/locks and optional outdated metadata without install/update. Input: project_root:string, manager?:auto|npm|pnpm|yarn|pip|uv|poetry|brew, check_outdated?:boolean. Output: manager, dependencies/lock facts, safe outdated summary. Contract: L2 read_only; scope mac.package.read; target project_root; timeout 30000ms; cap 512KiB; registry-read network only when enabled; filesystem read_allowed_project; secret files denied. Phase 3 planned."
  }
}
