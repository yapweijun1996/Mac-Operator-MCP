{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_read_file",
  "capability_level": "L1",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.files.read"
  ],
  "normalized_target_type": "path",
  "timeout_ms": 10000,
  "output_cap_bytes": 1048576,
  "network_policy": "none",
  "filesystem_policy": "read_allowed_roots",
  "secret_policy": "deny_secret_content",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "bounded_content_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "filesystem_read",
  "tool_delivery_wave": "wave_2",
  "implementation_status": "planned",
  "purpose": "safely read one allowed file with byte/range cap.",
  "input_summary": "path:string, offset?:integer, max_bytes?:1..1048576, encoding?:utf8|base64|metadata.",
  "output_summary": "bounded content/metadata and truncation flag.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_read_file input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "offset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1048576
      },
      "encoding": {
        "enum": [
          "utf8",
          "base64",
          "metadata"
        ]
      }
    },
    "required": [
      "path"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_read_file result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_read_file"
      },
