              "type": "object",
              "additionalProperties": false,
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^[^\\u0000]+$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "indicators": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 32,
                  "uniqueItems": false,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              },
              "required": [
                "root",
                "type",
                "indicators"
