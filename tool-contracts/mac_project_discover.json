            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "projects",
          "truncated"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
