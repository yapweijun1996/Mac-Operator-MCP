{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_docker_logs",
  "capability_level": "L2",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.docker.read"
  ],
  "normalized_target_type": "container_id",
  "timeout_ms": 15000,
  "output_cap_bytes": 1048576,
  "network_policy": "local_docker_only",
  "filesystem_policy": "none",
  "secret_policy": "redact",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "sanitized_docker_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "developer_read",
  "tool_delivery_wave": "wave_3",
  "implementation_status": "planned",
  "purpose": "return bounded sanitized logs for one authorized container.",
  "input_summary": "container_id:string, tail?:1..5000, since_seconds?:integer.",
  "output_summary": "log lines, time range, truncation.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_docker_logs input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "container_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^(?!-)(?!/)(?!(?:unix|tcp|http|https)://)[A-Za-z0-9._:/-]+$"
      },
      "tail": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000
      },
      "since_seconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31536000
      }
    },
    "required": [
      "container_id"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_docker_logs result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_docker_logs"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "container_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
          "pattern": "^(?!-)(?!/)(?!(?:unix|tcp|http|https)://)[A-Za-z0-9._:/-]+$"
          },
          "entries": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5000,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "timestamp": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "line": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 8192
                }
              },
              "required": [
                "line"
              ]
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "container_id",
          "entries",
          "truncated"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "sanitized_docker_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "0bdf5d78-c724-4b39-839c-3c959dc928fd",
    "source_text": "Purpose: return bounded sanitized logs for one authorized container. Input: container_id:string, tail?:1..5000, since_seconds?:integer. Output: log lines, time range, truncation. Contract: L2 read_only; scope mac.docker.read; target container_id; timeout 15000ms; cap 1MiB; local Docker only; no filesystem; option-like, absolute-path, and socket/HTTP URL targets denied; credential/secret-pattern redaction mandatory; approval trusted_read; idempotent yes. Phase 3 planned."
  }
}
