{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_git_commit",
  "capability_level": "L2",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.git.write"
  ],
  "normalized_target_type": "project_root",
  "timeout_ms": 30000,
  "output_cap_bytes": 524288,
  "network_policy": "none",
  "filesystem_policy": "write_allowed_project",
  "secret_policy": "redact",
  "approval_policy": "trusted_write",
  "idempotent": false,
  "postcondition_verification": {
    "required": true,
    "strategy": "commit_id_parent_and_staged_precondition",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "git_write",
  "tool_delivery_wave": "wave_3",
  "implementation_status": "planned",
  "purpose": "create a local Git commit from already staged content; never push or change remotes.",
  "input_summary": "project_root:string, message:string<=500, expected_staged_diff_sha256?:string.",
  "output_summary": "commit id, parent, staged-diff precondition and clean/dirty verification.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_git_commit input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "project_root": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "^[^\\u0000]+$"
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "expected_staged_diff_sha256": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    },
    "required": [
      "project_root",
      "message"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_git_commit result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_git_commit"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]+$"
          },
          "commit_id": {
            "type": "string",
            "minLength": 7,
            "maxLength": 64,
            "pattern": "^[A-Fa-f0-9]+$"
          },
          "parent_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 7,
              "maxLength": 64,
              "pattern": "^[A-Fa-f0-9]+$"
            }
          },
          "staged_diff_sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "precondition": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expected_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64,
                    "pattern": "^[A-Fa-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actual_sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "matched": {
                "type": "boolean"
              }
            },
            "required": [
              "matched",
              "actual_sha256"
            ]
          },
          "working_tree_state": {
            "enum": [
              "clean",
              "dirty"
            ]
          }
        },
        "required": [
          "project_root",
          "commit_id",
          "parent_ids",
          "staged_diff_sha256",
          "precondition",
          "working_tree_state"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "const": "commit_id_parent_and_staged_precondition"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "7efe2a5b-88e1-40dd-a7f2-10c572608370",
    "source_text": "Purpose: create a local Git commit from already staged content; never push or change remotes. Input: project_root:string, message:string<=500, expected_staged_diff_sha256?:string. Output: commit id, parent, staged-diff precondition and clean/dirty verification. Contract: L2 writes_local; scope mac.git.write; target project_root; timeout 30000ms; cap 512KiB; network none; filesystem write_allowed_project; secrets redacted; approval trusted_write; non-idempotent, guarded by expected staged hash. Phase 3 planned."
  }
}
