              "additionalProperties": false,
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99999999
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "executable": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "cpu_percent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "memory_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                },
                "owner": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 256
                }
              },
              "required": [
                "pid",
                "name",
                "executable",
                "cpu_percent",
                "memory_bytes"
              ]
            }
          }
        },
        "required": [
          "processes"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
