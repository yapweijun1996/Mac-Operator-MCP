  "audit_class": "observe",
  "tool_delivery_wave": "wave_2",
  "implementation_status": "planned",
  "purpose": "bounded process inventory.",
  "input_summary": "limit?:1..500, sort?:cpu|memory|pid|name.",
  "output_summary": "PID, executable identity, CPU/memory and safe owner metadata.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_process_list input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "sort": {
        "enum": [
          "cpu",
          "memory",
          "pid",
          "name"
        ]
      }
    },
    "required": []
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_process_list result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
