{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_process_list",
  "capability_level": "L0",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.process.read"
  ],
  "normalized_target_type": "process_set",
  "timeout_ms": 5000,
  "output_cap_bytes": 262144,
  "network_policy": "none",
  "filesystem_policy": "none",
  "secret_policy": "redact_env_args",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
