{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_ui_action",
  "capability_level": "L4",
  "safety_class": "writes_local",
  "required_scopes": [
    "mac.ui.control"
  ],
  "normalized_target_type": "ui_element",
  "timeout_ms": 15000,
  "output_cap_bytes": 786432,
  "network_policy": "none",
  "filesystem_policy": "none",
  "secret_policy": "deny_sensitive_targets",
  "approval_policy": "trusted_gui",
  "idempotent": false,
  "postcondition_verification": {
    "required": true,
    "strategy": "accessibility_reobservation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "gui_control",
  "tool_delivery_wave": "wave_4",
  "implementation_status": "planned",
  "purpose": "Perform one bounded Accessibility or visual action using a fresh authorized application or explicitly delegated desktop observation. Secure targets, protected sessions and sensitive submissions retain their existing approval boundaries.",
  "input_summary": "element_ref:observed element or visual_ref, action:bounded enum, x/y?:global macOS screen points -20000..20000, dx/dy?:scroll pixels, key?:allowlisted key, wait_ms?:0..2000.",
  "output_summary": "Accepted bounded action, application focus readback, and for visual actions a fresh screenshot returned as MCP image content.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_ui_action input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "element_ref": {
        "type": "string",
        "description": "A fresh observed Accessibility element_ref or screenshot visual_ref owned by this authenticated session. Desktop actions use the observed display visual_ref; arbitrary unobserved coordinates are unavailable.",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:/-]+$"
      },
      "action": {
        "enum": [
          "press",
          "select",
          "increment",
          "decrement",
          "show_menu",
          "focus",
          "click",
          "double_click",
          "right_click",
          "move_pointer",
          "scroll",
          "key_press",
          "shortcut",
          "wait"
        ]
      },
      "x": {
        "description": "Global macOS screen point -20000..20000, including secondary-display negative origins. Use an application window capture or desktop screen capture, then convert image pixel ix with floor(window_x + ix * window_width / image_width). Must stay within the observed target bounds.",
        "type": "integer",
        "minimum": -20000,
        "maximum": 20000
      },
      "y": {
        "description": "Global macOS screen point -20000..20000, including secondary-display negative origins. Use an application window capture or desktop screen capture, then convert image pixel iy with floor(window_y + iy * window_height / image_height). Must stay within the observed target bounds.",
        "type": "integer",
        "minimum": -20000,
        "maximum": 20000
      },
      "dx": {
        "type": "integer",
        "minimum": -1000,
        "maximum": 1000
      },
      "dy": {
        "type": "integer",
        "minimum": -1000,
        "maximum": 1000
      },
      "key": {
        "enum": [
          "ENTER",
          "TAB",
          "ESCAPE",
          "BACKSPACE",
          "ARROW_UP",
          "ARROW_DOWN",
          "ARROW_LEFT",
          "ARROW_RIGHT",
          "HOME",
          "END",
          "PAGE_UP",
          "PAGE_DOWN",
          "SPACE",
          "COMMAND_L",
          "COMMAND_R",
          "COMMAND_F"
        ]
      },
      "wait_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2000
      }
    },
    "required": [
      "element_ref",
      "action"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_ui_action result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_ui_action"
      },
      "result_class": {
        "const": "SUCCEEDED"
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "element_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          },
          "action": {
            "enum": [
              "press",
              "select",
              "increment",
              "decrement",
              "show_menu",
              "focus",
              "click",
              "double_click",
              "right_click",
              "move_pointer",
              "scroll",
              "key_press",
              "shortcut",
              "wait"
            ]
          },
          "accepted": {
            "type": "boolean"
          },
          "job_id": {
            "type": "string",
            "pattern": "^job:ui-action-[a-f0-9]{48}$"
          },
          "reobserved": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "enabled": {
                "type": "boolean"
              },
              "focused": {
                "type": "boolean"
              },
              "state": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "secure": {
                "const": false
              }
            },
            "required": [
              "role",
              "enabled",
              "focused"
            ]
          },
          "visual_ref": {
            "type": "string",
            "pattern": "^element:[a-f0-9]{48}$"
          },
          "window_title": {
            "type": "string",
            "maxLength": 512
          },
          "screenshot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "mime_type",
              "screen_width",
              "screen_height",
              "window_x",
              "window_y",
              "window_width",
              "window_height",
              "capture_width",
              "capture_height",
              "image_width",
              "image_height"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "screen",
                  "active_window",
                  "selected_window"
                ]
              },
              "mime_type": {
                "const": "image/jpeg"
              },
              "image_base64": {
                "type": "string",
                "minLength": 100,
                "maxLength": 640000,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "screen_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "screen_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "window_x": {
                "type": "integer",
                "minimum": -20000,
                "maximum": 20000
              },
              "window_y": {
                "type": "integer",
                "minimum": -20000,
                "maximum": 20000
              },
              "window_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "window_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "capture_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "capture_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "image_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              },
              "image_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20000
              }
            }
          }
        },
        "required": [
          "element_ref",
          "action",
          "accepted",
          "job_id",
          "reobserved"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": true
          },
          "status": {
            "enum": [
              "accepted",
              "verified",
              "failed",
              "unknown",
              "not_run"
            ]
          },
          "strategy": {
            "enum": [
              "accessibility_reobservation",
              "visual_action_dispatch"
            ]
          },
          "dispatch_status": {
            "const": "verified",
            "description": "The bounded event dispatch and approved target identity were verified. This does not prove an intended UI effect."
          },
          "postcondition_status": {
            "const": "unknown",
            "description": "The visual action accepts no intended UI postcondition, so its effect requires independent evaluation of a fresh observation."
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "b9155116-18c8-41e3-a8e9-924b0138e57d",
    "source_text": "Purpose: perform one supported Accessibility action on a previously resolved approved element. Input: element_ref:string, action:press|select|increment|decrement|show_menu|focus. Output: action result, Broker Job ID, and re-observed postcondition. Contract: L4 writes_local; scope mac.ui.control; target ui_element; timeout 15000ms; cap 256KiB; no network/filesystem; sensitive dialogs/security/credential UI denied; approval trusted_gui; non-idempotent unless action semantics are inherently safe. Phase 4 planned."
  }
}
