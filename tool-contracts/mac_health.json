{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_health",
  "capability_level": "L0",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.control.read"
  ],
  "normalized_target_type": "broker",
  "timeout_ms": 3000,
  "output_cap_bytes": 65536,
  "network_policy": "none",
  "filesystem_policy": "none",
  "secret_policy": "redact",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "component_health_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "observe",
  "tool_delivery_wave": "wave_1",
  "implementation_status": "planned",
  "purpose": "Report the Local Broker's health and version. A successful call also shows the Edge-to-Broker path is working. Edge, OAuth and GUI helper status are not reported here; use mac_capabilities for enabled tools and, when GUI tools are enabled, GUI helper and macOS permission state.",
  "input_summary": "include_components?:boolean.",
  "output_summary": "overall state plus one component entry for the Local Broker (name, status, version); components is empty when include_components is false.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_health input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "include_components": {
        "description": "Default true. When false, components is returned as an empty array.",
        "type": "boolean"
      }
    },
    "required": []
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_health result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_health"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "overall": {
            "description": "Currently healthy whenever the Broker answered; it is not derived from probes of other components.",
            "enum": [
              "healthy",
              "degraded",
              "unavailable",
              "disabled"
            ]
          },
          "components": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:@/+-]+$"
                },
                "status": {
                  "enum": [
                    "healthy",
                    "degraded",
                    "unavailable",
                    "disabled"
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 64
                },
                "detail": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 512
                }
              },
              "required": [
                "name",
                "status"
              ]
            }
          }
        },
        "required": [
          "overall",
          "components"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "component_health_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "13bd1c09-05e6-45fd-bbba-8505265098a8",
    "source_text": "Purpose: report Edge, Local Broker and optional helper health/version/reachability without secret material. Input: include_components?:boolean. Output: component states, versions, degraded reasons. Contract: L0 read_only; scope mac.control.read; target broker; timeout 3000ms; cap 64KiB; network none; filesystem none; secrets redacted; approval trusted_read; idempotent yes. Phase 1 planned. Must not return tokens, sockets with credentials or auth configuration values."
  }
}
