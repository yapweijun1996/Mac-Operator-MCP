{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_policy_explain",
  "capability_level": "L0",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.policy.explain"
  ],
  "normalized_target_type": "policy_request",
  "timeout_ms": 3000,
  "output_cap_bytes": 131072,
  "network_policy": "none",
  "filesystem_policy": "metadata_only",
  "secret_policy": "deny_secret_content",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "policy_decision_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "observe",
  "tool_delivery_wave": "wave_1",
  "implementation_status": "planned",
  "purpose": "dry-run Broker policy for a proposed tool/target/arguments; MUST NOT execute it.",
  "input_summary": "proposed_tool:string, target?:{kind,reference}, argument_digest?:sha256.",
  "output_summary": "allow/deny, normalized target summary, required/missing scopes, reason codes; sensitive values redacted.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_policy_explain input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "proposed_tool": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:@/+-]+$"
      },
      "target": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "host",
              "path",
              "project",
              "process",
              "job",
              "app",
              "app_window",
              "ui_element",
              "service",
              "package",
              "power"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9._:/-]+$"
          }
        },
        "required": [
          "kind",
          "reference"
        ]
      },
      "argument_digest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    },
    "required": [
      "proposed_tool"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_policy_explain result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_policy_explain"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "normalized_target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "kind",
              "reference"
            ]
          },
          "required_scopes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "missing_scopes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "reason_codes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": false,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "policy_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "decision",
          "normalized_target",
          "required_scopes",
          "missing_scopes",
          "reason_codes",
          "policy_version"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "policy_decision_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "2556a4e2-01c5-40fe-a045-9b5f75ad12c7",
    "source_text": "Purpose: dry-run Broker policy for a proposed tool/target/arguments; MUST NOT execute it. Input: proposed_tool:string, target?:object, arguments?:object. Output: allow/deny, normalized target summary, required/missing scopes, reason codes; sensitive values redacted. Contract: L0 read_only; scope mac.policy.explain; timeout 3000ms; cap 128KiB; network none; filesystem metadata-only; deny secret content; approval trusted_read; idempotent yes. Phase 1 planned."
  }
}
