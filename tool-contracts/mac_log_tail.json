{
  "$schema": "./tool-contract.schema.json",
  "schema_version": "0.1",
  "tool_name": "mac_log_tail",
  "capability_level": "L0",
  "safety_class": "read_only",
  "required_scopes": [
    "mac.log.read"
  ],
  "normalized_target_type": "log_source",
  "timeout_ms": 10000,
  "output_cap_bytes": 524288,
  "network_policy": "none",
  "filesystem_policy": "allowlisted_logs",
  "secret_policy": "redact",
  "approval_policy": "trusted_read",
  "idempotent": true,
  "postcondition_verification": {
    "required": false,
    "strategy": "sanitized_log_result_validation",
    "failure_class": "VERIFICATION_FAILED"
  },
  "audit_class": "observe",
  "tool_delivery_wave": "wave_2",
  "implementation_status": "planned",
  "purpose": "bounded tail from an allowlisted log source.",
  "input_summary": "source:string, lines?:1..2000, since_seconds?:integer.",
  "output_summary": "sanitized log entries plus truncation state.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_log_tail input",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "source": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._:@/+-]+$"
      },
      "lines": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2000
      },
      "since_seconds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31536000
      }
    },
    "required": [
      "source"
    ]
  },
  "output_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "mac_log_tail result",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ok",
      "request_id",
      "tool",
      "result_class",
      "data",
      "verification"
    ],
    "properties": {
      "ok": {
        "const": true
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "tool": {
        "const": "mac_log_tail"
      },
      "result_class": { "const": "SUCCEEDED" },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:@/+-]+$"
          },
          "entries": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2000,
            "uniqueItems": false,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "timestamp": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "format": "date-time"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "level": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 64
                },
                "message": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 8192
                }
              },
              "required": [
                "message"
              ]
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "entries",
          "truncated"
        ]
      },
      "warnings": {
        "type": "array",
        "minItems": 0,
        "maxItems": 32,
        "uniqueItems": false,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "truncated": {
        "type": "boolean"
      },
      "verification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "status",
          "strategy"
        ],
        "properties": {
          "required": {
            "const": false
          },
          "status": {
            "enum": [
              "not_required",
              "verified",
              "failed",
              "unknown"
            ]
          },
          "strategy": {
            "const": "sanitized_log_result_validation"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 0,
                "maxLength": 512
              },
              "readback_hash": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "format": "date-time"
              }
            },
            "required": []
          }
        }
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000
      }
    }
  },
  "source": {
    "kbid": "mac-operator-mcp",
    "kb_id": "90f1df58-87f6-4f47-aa9a-2881c478f8a0",
    "kb_item_id": "07566ecc-7381-456b-814b-85cc79472bb3",
    "source_text": "Purpose: bounded tail from an allowlisted log source. Input: source:string, lines?:1..2000, since_seconds?:integer. Output: sanitized log entries plus truncation state. Contract: L0 read_only; scope mac.log.read; target log_source; timeout 10000ms; cap 512KiB; network none; filesystem allowlisted_logs; secret-pattern redaction mandatory; approval trusted_read; idempotent yes. Phase 2 planned."
  }
}
